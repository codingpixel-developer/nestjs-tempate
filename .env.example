# --- App ---
NODE_ENV=development
APP_NAME=Template
PORT=5614
# Public URL of the frontend (used for CORS and email links)
FRONTEND_URL=http://localhost:5173
# Public base URL of THIS API (used to expand relative asset paths to full URLs)
APP_URL=http://localhost:5614

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=template
DATABASE_SYNC=false
DATABASE_AUTOLOAD=true

# --- JWT ---
JWT_SECRET=replace-with-a-long-random-string
JWT_SECRET_ADMIN=replace-with-a-long-random-string
JWT_SECRET_VERIFICATION=replace-with-a-long-random-string
JWT_SECRET_RESET_PASSWORD=replace-with-a-long-random-string
JWT_TOKEN_AUDIENCE=http://localhost:5614
JWT_TOKEN_ISSUER=http://localhost:5614
JWT_ACCESS_TOKEN_TTL=3600
JWT_REFRESH_TOKEN_TTL=86400

# --- Mail (SMTP) ---
MAIL_HOST=smtp.example.com
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=Template

# --- Admin seeder (npm run seed:admin) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
